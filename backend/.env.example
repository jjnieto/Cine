# Canal Fabric
FABRIC_CHANNEL=productoras

# Carpeta raíz de las orgs peer (la genera cryptogen vía network.sh).
# Por defecto sirve la ruta relativa que apunta al material del repo.
FABRIC_ORGS_DIR=../network/organizations/peerOrganizations

# HSM stub: en producción usar PKCS#11 contra HSM real.
HSM_BACKEND=file
HSM_KEYSTORE_PATH=./.hsm-dev

PORT=3000
